# ╔════════════════════════════════════════════════════════════╗
# ║       NodeLoc 社区发卡系统 - 生产环境配置示例                ║
# ╚════════════════════════════════════════════════════════════╝
# 使用 Docker Compose 一键部署时使用此配置

# ===========================================
# 域名 & SSL（必填）
# ===========================================
# 你的域名（确保 DNS 已解析到本服务器）
DOMAIN=your-domain.com

# Let's Encrypt 证书申请邮箱（用于证书到期提醒）
SSL_EMAIL=your-email@example.com

# ===========================================
# 数据库配置（Docker 内置 MySQL）
# ===========================================
DB_ROOT_PASSWORD=your_strong_root_password_here
DB_NAME=faka
DB_USER=faka
DB_PASSWORD=your_strong_db_password_here
DB_PORT=3306

# ===========================================
# 服务器配置
# ===========================================
# Session 密钥（建议使用随机字符串，至少32位）
SESSION_SECRET=your_random_session_secret_here_32_chars

# Gin 运行模式
GIN_MODE=release

# ===========================================
# Docker 镜像配置
# ===========================================
DOCKER_IMAGE_BACKEND=nodeloc/faka-backend:latest
DOCKER_IMAGE_FRONTEND=nodeloc/faka-frontend:latest

# ===========================================
# NodeLoc OAuth 配置（必填）
# ===========================================
NODELOC_URL=https://www.nodeloc.com
NODELOC_CLIENT_ID=your-oauth-client-id
NODELOC_CLIENT_SECRET=your-oauth-client-secret
# 回调地址填你的域名
NODELOC_REDIRECT_URI=https://your-domain.com/auth/callback

# ===========================================
# NodeLoc Payment 配置（可选）
# ===========================================
PAYMENT_ID=
PAYMENT_SECRET=
PAYMENT_CALLBACK_URI=https://your-domain.com/payment/callback

# ===========================================
# 邮件配置（可选，用于订单通知等）
# ===========================================
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
ADMIN_EMAIL=
